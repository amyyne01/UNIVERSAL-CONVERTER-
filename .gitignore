# Dependencies
node_modules/

# Build output
dist/
dist-electron/
dev-release/
release/

# Secrets — NEVER commit. Both formats, everywhere they can land.
.env
.env.*
*.env
config/.env
config/secrets.json

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db

# Local agent/tool state — not part of the product
graphify-out/
.omc/
.claude/
coverage/
# Throwaway drivers used to measure/capture the real app (see HISTORY).
.shot.mjs
.shots.mjs
.probe.mjs
.gif.mjs
screenshots/responsive-*.png
screenshots/.gifframes/
screenshots/trace-check.png

# Entitlement/activation layer — never published. The app builds locally with
# these present; they are deliberately absent from the public tree.
electron/license.ts
electron/license.test.ts
config/secrets.template.json

# Internal working documents. The published repo is code + README only:
# every other markdown file is planning, audit or design material that stays local.
*.md
!README.md
docs/
design-concepts/

# Rust port. Build output, and the entitlement layer (same rule as
# electron/license.ts above). It sits behind the off-by-default `license`
# cargo feature, so the tracked tree builds without it.
target/
crates/ahg-engine/src/license.rs
crates/ahg-engine/src/license/
crates/ahg-engine/tests/license*.rs
crates/**/secrets.gen.rs

# Rust port: the entitlement layer stays out of the public tree here too.
crates/ahg-engine/tests/golden/license*.json
scripts/rust-golden/license.mjs

# Match-scorer research data: third-party metadata, kept local.
tools/match-model/data/
